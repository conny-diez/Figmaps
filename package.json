{
  "name": "figmaps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Figma plugin that predicts visual attention (heatmap, clickmap, focusmap) for a selected frame.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src scripts",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@figma/eslint-plugin-figma-plugins": "^1.0.0",
    "@figma/plugin-typings": "^1.133.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.0",
    "preact": "^10.29.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.10"
  }
}
