{
  "name": "figmaps",
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Figma plugin that predicts visual attention (heatmap, clickmap, focusmap, above-the-fold) for a selected frame, with an offline evaluation harness.",
  "scripts": {
    "prepare": "lefthook install",
    "changelog": "node scripts/changelog.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src eval scripts",
    "eval": "node scripts/eval.mjs",
    "eval:fixtures": "node scripts/fixtures.mjs",
    "gate-fixtures": "node scripts/eval.mjs --gate-fixtures",
    "tune": "node scripts/eval.mjs --tune",
    "diagnose": "node scripts/eval.mjs --diagnose",
    "build-prior": "node scripts/eval.mjs --build-prior",
    "verify": "npm run typecheck && npm run test && npm run build",
    "crossval": "node scripts/eval.mjs --crossval",
    "alpha": "node scripts/eval.mjs --alpha",
    "sharpness": "node scripts/eval.mjs --sharpness",
    "groups": "node scripts/eval.mjs --groups",
    "cutoff": "node scripts/eval.mjs --cutoff",
    "band-gate": "node scripts/eval.mjs --band-gate",
    "cold-fold": "node scripts/eval.mjs --cold-fold",
    "finding-load": "node scripts/eval.mjs --finding-load",
    "competition": "node scripts/eval.mjs --competition",
    "contrast-check": "node scripts/eval.mjs --contrast-check",
    "measurable": "node scripts/eval.mjs --measurable",
    "contrast-gate": "node scripts/eval.mjs --contrast-gate",
    "check-release": "node scripts/check-release.mjs",
    "check-published-release": "node scripts/check-published-release.mjs",
    "header-weight": "node scripts/eval.mjs --header-weight",
    "visual-check": "node scripts/eval.mjs --visual-check",
    "side-effects": "node scripts/eval.mjs --side-effects",
    "epic-d": "node scripts/eval.mjs --epic-d",
    "findings-audit": "node scripts/eval.mjs --findings-audit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.0",
    "@figma/eslint-plugin-figma-plugins": "^1.0.0",
    "@figma/plugin-typings": "^1.133.0",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.0",
    "lefthook": "^2.1.10",
    "preact": "^10.29.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.10"
  }
}
